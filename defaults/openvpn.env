OPENVPN_BIND=127.0.0.1
OPENVPN_PORT=1194
OPENVPN_PROTO=tcp
OPENVPN_PUBLIC_HOST=
OPENVPN_PUBLIC_PORT=443
OPENVPN_NETWORK=10.8.0.0
OPENVPN_MAX_CLIENTS=128
OPENVPN_FULL_TUNNEL=no
OPENVPN_PUSH_DNS1=
OPENVPN_PUSH_DNS2=
# password = usuário/senha OnePlus via PAM
# hybrid   = usuário/senha OnePlus + certificado mTLS individual por dispositivo
OPENVPN_AUTH_MODE=password

# legacy = chave tls-crypt compartilhada; dual = legado + tls-crypt-v2; v2 = somente tls-crypt-v2
OPENVPN_TLS_CRYPT_MODE=legacy
