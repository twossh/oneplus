# Preencha SLOWDNS_DOMAIN antes de habilitar o serviço.
SLOWDNS_DOMAIN=
# 0.0.0.0 escuta em todas as interfaces IPv4; altere se desejar restringir.
SLOWDNS_BIND=0.0.0.0
SLOWDNS_PORT=53
# IPv4 público usado apenas para orientar os registros DNS.
SLOWDNS_PUBLIC_IP=
# Destino do túnel DNS. Para SSH direto use 127.0.0.1:22.
SLOWDNS_UPSTREAM=127.0.0.1:22
SLOWDNS_MTU=1232
SLOWDNS_PRIVKEY=/etc/oneplus/slowdns/server.key
SLOWDNS_PUBKEY=/etc/oneplus/slowdns/server.pub
