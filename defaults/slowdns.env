# Preencha SLOWDNS_DOMAIN antes de habilitar o serviço.
SLOWDNS_DOMAIN=
# Na configuração interativa o OnePlus sugere o IPv4 da interface principal.
# Evitar 0.0.0.0 ajuda a coexistir com o stub local do systemd-resolved em Ubuntu.
SLOWDNS_BIND=
SLOWDNS_PORT=53
# IPv4 público usado apenas para orientar os registros DNS; pode ser diferente do bind em VPS com NAT.
SLOWDNS_PUBLIC_IP=
# Destino do túnel DNS. Para SSH direto use 127.0.0.1:22.
SLOWDNS_UPSTREAM=127.0.0.1:22
SLOWDNS_MTU=1232
SLOWDNS_PRIVKEY=/etc/oneplus/slowdns/server.key
SLOWDNS_PUBKEY=/etc/oneplus/slowdns/server.pub
