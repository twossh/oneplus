#!/usr/bin/env bash
set -Eeuo pipefail
CONF=/etc/oneplus/badvpn.env
BIN=/usr/local/lib/oneplus/bin/badvpn-udpgw
[[ -r "$CONF" ]] || { echo "Configuração ausente: $CONF" >&2; exit 1; }
[[ -x "$BIN" ]] || { echo "badvpn-udpgw não instalado." >&2; exit 1; }

BADVPN_BIND="127.0.0.1:7300"
BADVPN_LOGLEVEL="warning"
BADVPN_MAX_CLIENTS="500"
BADVPN_MAX_CONNECTIONS="64"
BADVPN_SNDBUF="1048576"

while IFS='=' read -r key value; do
  [[ -z "$key" || "$key" == \#* ]] && continue
  case "$key" in
    BADVPN_BIND) BADVPN_BIND=$value ;;
    BADVPN_LOGLEVEL) BADVPN_LOGLEVEL=$value ;;
    BADVPN_MAX_CLIENTS) BADVPN_MAX_CLIENTS=$value ;;
    BADVPN_MAX_CONNECTIONS) BADVPN_MAX_CONNECTIONS=$value ;;
    BADVPN_SNDBUF) BADVPN_SNDBUF=$value ;;
  esac
done < "$CONF"

valid_ipv4() {
  local ip="$1" IFS=. parts o
  read -r -a parts <<< "$ip"
  [[ ${#parts[@]} -eq 4 ]] || return 1
  for o in "${parts[@]}"; do
    [[ "$o" =~ ^[0-9]{1,3}$ ]] || return 1
    (( 10#$o <= 255 )) || return 1
  done
}
valid_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

[[ "$BADVPN_BIND" =~ ^([0-9.]+):([0-9]+)$ ]] || { echo "BADVPN_BIND inválido." >&2; exit 1; }
bind=${BASH_REMATCH[1]}; port=${BASH_REMATCH[2]}
valid_ipv4 "$bind" || { echo "BADVPN_BIND inválido." >&2; exit 1; }
valid_uint "$port" && (( 10#$port >= 1024 && 10#$port <= 65535 )) || { echo "Porta UDPGW inválida (1024..65535)." >&2; exit 1; }
[[ "$BADVPN_LOGLEVEL" =~ ^(error|warning|notice|info|debug)$ ]] || { echo "BADVPN_LOGLEVEL inválido." >&2; exit 1; }
valid_uint "$BADVPN_MAX_CLIENTS" && (( 10#$BADVPN_MAX_CLIENTS >= 1 && 10#$BADVPN_MAX_CLIENTS <= 10000 )) || { echo "BADVPN_MAX_CLIENTS inválido." >&2; exit 1; }
valid_uint "$BADVPN_MAX_CONNECTIONS" && (( 10#$BADVPN_MAX_CONNECTIONS >= 1 && 10#$BADVPN_MAX_CONNECTIONS <= 1000 )) || { echo "BADVPN_MAX_CONNECTIONS inválido." >&2; exit 1; }
valid_uint "$BADVPN_SNDBUF" && (( 10#$BADVPN_SNDBUF >= 65536 && 10#$BADVPN_SNDBUF <= 16777216 )) || { echo "BADVPN_SNDBUF inválido." >&2; exit 1; }

exec "$BIN" \
  --loglevel "$BADVPN_LOGLEVEL" \
  --listen-addr "$BADVPN_BIND" \
  --max-clients "$BADVPN_MAX_CLIENTS" \
  --max-connections-for-client "$BADVPN_MAX_CONNECTIONS" \
  --client-socket-sndbuf "$BADVPN_SNDBUF"
