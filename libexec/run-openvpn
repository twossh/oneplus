#!/usr/bin/env bash
set -Eeuo pipefail

CONF=/etc/oneplus/openvpn.env
PKI=/etc/oneplus/openvpn/pki
CA="$PKI/ca.crt"
CERT="$PKI/server.crt"
KEY="$PKI/server.key"
TLS_CRYPT=/etc/oneplus/openvpn/tls-crypt.key
CRL=/etc/oneplus/openvpn/ca-db/crl.pem
RUNTIME_DIR=/run/oneplus-openvpn
RUNTIME_CONF="$RUNTIME_DIR/server.conf"
PAM_SERVICE=/etc/pam.d/oneplus-openvpn

[[ -r "$CONF" ]] || { echo "Configuração ausente: $CONF" >&2; exit 1; }
[[ -s "$CA" && -s "$CERT" && -s "$KEY" && -s "$TLS_CRYPT" ]] || { echo "PKI OpenVPN incompleta." >&2; exit 1; }
[[ -r "$PAM_SERVICE" ]] || { echo "Serviço PAM OnePlus OpenVPN ausente." >&2; exit 1; }
command -v openvpn >/dev/null 2>&1 || { echo "openvpn não instalado." >&2; exit 1; }

getv() {
  local key="$1" line
  line=$(grep -E "^${key}=" "$CONF" 2>/dev/null | tail -n1 || true)
  printf '%s' "${line#*=}"
}
valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
valid_ipv4() {
  local ip="$1" IFS=. parts o
  read -r -a parts <<< "$ip"
  [[ ${#parts[@]} -eq 4 ]] || return 1
  for o in "${parts[@]}"; do
    [[ "$o" =~ ^[0-9]{1,3}$ ]] || return 1
    (( 10#$o <= 255 )) || return 1
  done
}
valid_private_24() {
  local ip="$1" a b c d
  valid_ipv4 "$ip" || return 1
  IFS=. read -r a b c d <<< "$ip"
  (( 10#$d == 0 )) || return 1
  if (( 10#$a == 10 )); then return 0; fi
  if (( 10#$a == 172 && 10#$b >= 16 && 10#$b <= 31 )); then return 0; fi
  if (( 10#$a == 192 && 10#$b == 168 )); then return 0; fi
  return 1
}

bind=$(getv OPENVPN_BIND)
port=$(getv OPENVPN_PORT)
proto=$(getv OPENVPN_PROTO)
network=$(getv OPENVPN_NETWORK)
max_clients=$(getv OPENVPN_MAX_CLIENTS)
full_tunnel=$(getv OPENVPN_FULL_TUNNEL)
push_dns1=$(getv OPENVPN_PUSH_DNS1)
push_dns2=$(getv OPENVPN_PUSH_DNS2)
auth_mode=$(getv OPENVPN_AUTH_MODE); auth_mode=${auth_mode:-password}

valid_ipv4 "$bind" || { echo "OPENVPN_BIND inválido." >&2; exit 1; }
valid_port "$port" || { echo "OPENVPN_PORT inválido." >&2; exit 1; }
[[ "$proto" == tcp || "$proto" == udp ]] || { echo "OPENVPN_PROTO deve ser tcp ou udp." >&2; exit 1; }
valid_private_24 "$network" || { echo "OPENVPN_NETWORK deve ser rede privada RFC1918 /24 terminada em .0." >&2; exit 1; }
valid_uint "$max_clients" && (( 10#$max_clients >= 1 && 10#$max_clients <= 250 )) || { echo "OPENVPN_MAX_CLIENTS inválido (1..250)." >&2; exit 1; }
[[ "$full_tunnel" == yes || "$full_tunnel" == no ]] || { echo "OPENVPN_FULL_TUNNEL deve ser yes/no." >&2; exit 1; }
[[ "$auth_mode" == password || "$auth_mode" == hybrid ]] || { echo "OPENVPN_AUTH_MODE deve ser password ou hybrid." >&2; exit 1; }
[[ -z "$push_dns1" ]] || valid_ipv4 "$push_dns1" || { echo "OPENVPN_PUSH_DNS1 inválido." >&2; exit 1; }
[[ -z "$push_dns2" ]] || valid_ipv4 "$push_dns2" || { echo "OPENVPN_PUSH_DNS2 inválido." >&2; exit 1; }
if [[ "$auth_mode" == hybrid ]]; then
  [[ -s "$CRL" ]] || { echo "Modo hybrid exige CRL válida: $CRL" >&2; exit 1; }
  openssl crl -in "$CRL" -noout -verify -CAfile "$CA" >/dev/null 2>&1 || { echo "CRL OpenVPN inválida." >&2; exit 1; }
fi

plugin=$(find /usr/lib -type f -name 'openvpn-plugin-auth-pam.so' -print -quit 2>/dev/null || true)
[[ -n "$plugin" && -r "$plugin" ]] || { echo "Plugin PAM do OpenVPN não encontrado." >&2; exit 1; }

install -d -m 0700 -o root -g root "$RUNTIME_DIR"
umask 077
if [[ "$proto" == tcp ]]; then
  ovpn_proto=tcp4-server
else
  ovpn_proto=udp4
fi

cat > "$RUNTIME_CONF" <<EOF2
mode server
tls-server
local ${bind}
port ${port}
proto ${ovpn_proto}
dev tun
topology subnet
server ${network} 255.255.255.0
ca ${CA}
cert ${CERT}
key ${KEY}
dh none
tls-crypt ${TLS_CRYPT}
tls-version-min 1.2
username-as-common-name
plugin ${plugin} oneplus-openvpn
data-ciphers AES-256-GCM:AES-128-GCM:?CHACHA20-POLY1305
auth SHA256
allow-compression no
max-clients ${max_clients}
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
management ${RUNTIME_DIR}/management.sock unix
management-client-user root
management-client-group root
verb 3
mute 10
EOF2

if [[ "$auth_mode" == hybrid ]]; then
  cat >> "$RUNTIME_CONF" <<EOF2
verify-client-cert require
remote-cert-tls client
crl-verify ${CRL}
EOF2
else
  printf 'verify-client-cert none\n' >> "$RUNTIME_CONF"
fi

if [[ "$full_tunnel" == yes ]]; then
  printf 'push "redirect-gateway def1 bypass-dhcp"\n' >> "$RUNTIME_CONF"
  [[ -z "$push_dns1" ]] || printf 'push "dhcp-option DNS %s"\n' "$push_dns1" >> "$RUNTIME_CONF"
  [[ -z "$push_dns2" ]] || printf 'push "dhcp-option DNS %s"\n' "$push_dns2" >> "$RUNTIME_CONF"
fi

exec /usr/sbin/openvpn --config "$RUNTIME_CONF"
