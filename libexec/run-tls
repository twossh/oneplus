#!/usr/bin/env bash
set -Eeuo pipefail
CONF=/etc/oneplus/tls.env
CERT=/etc/oneplus/tls/server.crt
KEY=/etc/oneplus/tls/server.key
RUNTIME=/run/oneplus-tls/stunnel.conf

[[ -r "$CONF" ]] || { echo "Configuração ausente: $CONF" >&2; exit 1; }
[[ -s "$CERT" && -s "$KEY" ]] || { echo "Certificado/chave TLS ausentes." >&2; exit 1; }
[[ -x /usr/bin/stunnel4 || -x /usr/bin/stunnel ]] || { echo "stunnel não instalado." >&2; exit 1; }

getv() {
  local key="$1" line
  line=$(grep -E "^${key}=" "$CONF" | tail -n1 || true)
  printf '%s' "${line#*=}"
}
valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_ipv4() {
  local ip="$1" IFS=. parts o
  read -r -a parts <<< "$ip"
  [[ ${#parts[@]} -eq 4 ]] || return 1
  for o in "${parts[@]}"; do
    [[ "$o" =~ ^[0-9]{1,3}$ ]] || return 1
    (( 10#$o <= 255 )) || return 1
  done
}
valid_hostport() {
  local value="$1" host port
  [[ "$value" == *:* ]] || return 1
  host=${value%:*}; port=${value##*:}
  valid_port "$port" || return 1
  [[ "$host" == localhost ]] && return 0
  valid_ipv4 "$host" && return 0
  [[ "$host" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]
}

bind=$(getv TLS_BIND)
port=$(getv TLS_PORT)
upstream=$(getv TLS_UPSTREAM)
minver=$(getv TLS_MIN_VERSION)
valid_ipv4 "$bind" || { echo "TLS_BIND inválido." >&2; exit 1; }
valid_port "$port" || { echo "TLS_PORT inválido." >&2; exit 1; }
valid_hostport "$upstream" || { echo "TLS_UPSTREAM inválido." >&2; exit 1; }
[[ "$minver" == TLSv1.2 || "$minver" == TLSv1.3 ]] || { echo "TLS_MIN_VERSION inválido." >&2; exit 1; }

umask 077
cat > "$RUNTIME" <<EOF2
foreground = yes
syslog = no
debug = notice
sslVersionMin = ${minver}

[oneplus]
accept = ${bind}:${port}
connect = ${upstream}
cert = ${CERT}
key = ${KEY}
EOF2

stunnel_bin=/usr/bin/stunnel4
[[ -x "$stunnel_bin" ]] || stunnel_bin=/usr/bin/stunnel
exec "$stunnel_bin" "$RUNTIME"
