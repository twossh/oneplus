#!/usr/bin/env bash
set -Eeuo pipefail
CONF=/etc/oneplus/websocket.env
SCRIPT=/opt/oneplus/libexec/websocket_proxy.py

[[ -r "$CONF" ]] || { echo "Configuração ausente: $CONF" >&2; exit 1; }
[[ -r "$SCRIPT" ]] || { echo "Proxy WebSocket ausente: $SCRIPT" >&2; exit 1; }

getv() {
  local key="$1" line
  line=$(grep -E "^${key}=" "$CONF" | tail -n1 || true)
  printf '%s' "${line#*=}"
}
valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_uint() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 > 0 )); }
valid_ipv4() {
  local ip="$1" IFS=. parts o
  read -r -a parts <<< "$ip"
  [[ ${#parts[@]} -eq 4 ]] || return 1
  for o in "${parts[@]}"; do
    [[ "$o" =~ ^[0-9]{1,3}$ ]] || return 1
    (( 10#$o <= 255 )) || return 1
  done
}
valid_hostport() {
  local value="$1" host port
  [[ "$value" == *:* ]] || return 1
  host=${value%:*}; port=${value##*:}
  valid_port "$port" || return 1
  [[ "$host" == localhost ]] && return 0
  valid_ipv4 "$host" && return 0
  [[ "$host" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]
}

bind=$(getv WS_BIND)
port=$(getv WS_PORT)
upstream=$(getv WS_UPSTREAM)
path=$(getv WS_PATH)
mode=$(getv WS_MODE)
max_clients=$(getv WS_MAX_CLIENTS)
header_limit=$(getv WS_HEADER_LIMIT)
max_frame=$(getv WS_MAX_FRAME)

valid_ipv4 "$bind" || { echo "WS_BIND inválido." >&2; exit 1; }
valid_port "$port" || { echo "WS_PORT inválido." >&2; exit 1; }
valid_hostport "$upstream" || { echo "WS_UPSTREAM inválido." >&2; exit 1; }
[[ "$path" =~ ^/[A-Za-z0-9._~/%-]*$ ]] || { echo "WS_PATH inválido." >&2; exit 1; }
[[ "$mode" == auto || "$mode" == rfc6455 || "$mode" == legacy ]] || { echo "WS_MODE inválido." >&2; exit 1; }
valid_uint "$max_clients" && (( 10#$max_clients <= 4096 )) || { echo "WS_MAX_CLIENTS inválido (1..4096)." >&2; exit 1; }
valid_uint "$header_limit" && (( 10#$header_limit >= 1024 && 10#$header_limit <= 65536 )) || { echo "WS_HEADER_LIMIT inválido (1024..65536)." >&2; exit 1; }
valid_uint "$max_frame" && (( 10#$max_frame >= 125 && 10#$max_frame <= 67108864 )) || { echo "WS_MAX_FRAME inválido (125..67108864)." >&2; exit 1; }

exec /usr/bin/python3 "$SCRIPT" \
  --bind "$bind" --port "$port" --upstream "$upstream" --path "$path" --mode "$mode" \
  --max-clients "$max_clients" --header-limit "$header_limit" --max-frame "$max_frame"
