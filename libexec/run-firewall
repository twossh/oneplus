#!/usr/bin/env bash
set -Eeuo pipefail

CONF=/etc/oneplus/firewall.env
OPENVPN_CONF=/etc/oneplus/openvpn.env
RUNTIME=/run/oneplus-firewall
RULES="$RUNTIME/rules.nft"

getv() {
  local file="$1" key="$2" line
  line=$(grep -E "^${key}=" "$file" 2>/dev/null | tail -n1 || true)
  printf '%s' "${line#*=}"
}
valid_yesno() { [[ "$1" == yes || "$1" == no ]]; }
valid_iface() { [[ "$1" =~ ^[A-Za-z0-9_.:-]{1,15}$ ]]; }
valid_ipv4() {
  local ip="$1" IFS=. p o
  read -r -a p <<< "$ip"
  [[ ${#p[@]} -eq 4 ]] || return 1
  for o in "${p[@]}"; do [[ "$o" =~ ^[0-9]{1,3}$ ]] && ((10#$o <= 255)) || return 1; done
}
valid_private24() {
  local ip="$1" a b c d
  valid_ipv4 "$ip" || return 1
  IFS=. read -r a b c d <<< "$ip"
  ((10#$d == 0)) || return 1
  ((10#$a == 10)) && return 0
  ((10#$a == 172 && 10#$b >= 16 && 10#$b <= 31)) && return 0
  ((10#$a == 192 && 10#$b == 168)) && return 0
  return 1
}
remove_tables() {
  nft list table inet oneplus_filter >/dev/null 2>&1 && nft delete table inet oneplus_filter || true
  nft list table ip oneplus_nat >/dev/null 2>&1 && nft delete table ip oneplus_nat || true
}

case "${1:-}" in
  apply)
    [[ -r "$CONF" && -r "$OPENVPN_CONF" ]] || { echo "Configuração OnePlus ausente." >&2; exit 1; }
    command -v nft >/dev/null 2>&1 || { echo "nftables não instalado." >&2; exit 1; }
    enabled=$(getv "$CONF" OPENVPN_NAT_ENABLED)
    egress=$(getv "$CONF" OPENVPN_EGRESS_IFACE)
    tun=$(getv "$CONF" OPENVPN_TUN_IFACE)
    network=$(getv "$OPENVPN_CONF" OPENVPN_NETWORK)
    valid_yesno "$enabled" || { echo "OPENVPN_NAT_ENABLED inválido." >&2; exit 1; }
    valid_iface "$tun" || { echo "OPENVPN_TUN_IFACE inválida." >&2; exit 1; }
    valid_private24 "$network" || { echo "OPENVPN_NETWORK inválida." >&2; exit 1; }
    install -d -m 0755 "$RUNTIME"
    : > "$RULES"
    if [[ "$enabled" == yes ]]; then
      valid_iface "$egress" || { echo "OPENVPN_EGRESS_IFACE inválida." >&2; exit 1; }
      ip link show dev "$egress" >/dev/null 2>&1 || { echo "Interface de saída inexistente: $egress" >&2; exit 1; }
      cat > "$RULES" <<EOF2
# Gerado pelo OnePlus. Somente tabelas com prefixo oneplus são gerenciadas.
table inet oneplus_filter {
  chain forward {
    type filter hook forward priority 20; policy accept;
    iifname "${tun}" oifname "${egress}" counter accept comment "oneplus vpn outbound"
    iifname "${egress}" oifname "${tun}" ct state established,related counter accept comment "oneplus vpn return"
  }
}
table ip oneplus_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr ${network}/24 oifname "${egress}" counter masquerade comment "oneplus openvpn nat"
  }
}
EOF2
      nft -c -f "$RULES"
      remove_tables
      nft -f "$RULES"
    else
      remove_tables
    fi
    ;;
  remove)
    command -v nft >/dev/null 2>&1 || exit 0
    remove_tables
    ;;
  validate)
    "$0" apply
    "$0" remove
    ;;
  *) echo "Uso: $0 {apply|remove|validate}" >&2; exit 2 ;;
esac
