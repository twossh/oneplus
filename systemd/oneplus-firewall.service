[Unit]
Description=OnePlus nftables rules (isolated tables only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/oneplus/libexec/run-firewall apply
ExecStop=/opt/oneplus/libexec/run-firewall remove
RemainAfterExit=yes
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
