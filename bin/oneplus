#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$ROOT_DIR/lib/common.sh"
# shellcheck source=../lib/os.sh
source "$ROOT_DIR/lib/os.sh"
source "$ROOT_DIR/modules/system.sh"
source "$ROOT_DIR/modules/ssh.sh"
source "$ROOT_DIR/modules/dropbear.sh"
source "$ROOT_DIR/modules/websocket.sh"
source "$ROOT_DIR/modules/tls.sh"
source "$ROOT_DIR/modules/openvpn.sh"
source "$ROOT_DIR/modules/mux.sh"
source "$ROOT_DIR/modules/badvpn.sh"
source "$ROOT_DIR/modules/slowdns.sh"
source "$ROOT_DIR/modules/users.sh"
source "$ROOT_DIR/modules/firewall.sh"
source "$ROOT_DIR/modules/backup.sh"
source "$ROOT_DIR/modules/reports.sh"
source "$ROOT_DIR/modules/diagnostics.sh"
source "$ROOT_DIR/modules/update.sh"
source "$ROOT_DIR/modules/history.sh"
source "$ROOT_DIR/modules/hardening.sh"

require_root
check_supported_os

VERSION=$(cat "$ROOT_DIR/VERSION" 2>/dev/null || echo dev)

health_check() {
  local failed=0
  printf "%bOnePlus %s • verificação%b\n\n" "$C_BOLD$C_CYAN" "$VERSION" "$C_RESET"

  check_item() {
    local label="$1"
    shift
    if "$@" >/dev/null 2>&1; then
      printf "%b[OK]%b %s\n" "$C_GREEN" "$C_RESET" "$label"
    else
      printf "%b[FALHA]%b %s\n" "$C_RED" "$C_RESET" "$label"
      failed=1
    fi
  }

  check_item "Ubuntu 24.04+" check_supported_os
  check_item "OpenSSH: configuração válida" sshd -t
  check_item "Launcher instalado" test -L /usr/local/bin/oneplus
  check_item "Árvore /opt/oneplus" test -r /opt/oneplus/VERSION
  check_item "BadVPN UDPGW instalado" test -x /usr/local/lib/oneplus/bin/badvpn-udpgw
  check_item "BadVPN UDPGW íntegro" sha256sum -c /var/lib/oneplus/badvpn.sha256
  check_item "dnstt-server instalado" test -x /usr/local/lib/oneplus/bin/dnstt-server
  check_item "dnstt-server íntegro" sha256sum -c /var/lib/oneplus/dnstt.sha256
  check_item "Dropbear instalado pelo Ubuntu" test -x /usr/sbin/dropbear
  check_item "Stunnel instalado pelo Ubuntu" bash -c 'command -v stunnel4 >/dev/null 2>&1 || command -v stunnel >/dev/null 2>&1'
  check_item "OpenVPN instalado pelo Ubuntu" test -x /usr/sbin/openvpn
  check_item "Plugin PAM OpenVPN" bash -c "find /usr/lib -type f -name openvpn-plugin-auth-pam.so -print -quit | grep -q ."
  check_item "PAM OpenVPN restrito ao OnePlus/root negado" bash -c "grep -Fq 'user ingroup oneplus-users' /etc/pam.d/oneplus-openvpn && grep -Fq 'user != root' /etc/pam.d/oneplus-openvpn"
  check_item "sslh-select instalado pelo Ubuntu" test -x /usr/sbin/sslh-select
  check_item "Componentes Python 3" python3 -m py_compile /opt/oneplus/libexec/websocket_proxy.py /opt/oneplus/libexec/openvpn_manager.py /opt/oneplus/libexec/release_verify.py /opt/oneplus/libexec/github_release.py /opt/oneplus/libexec/history_snapshot.py /opt/oneplus/libexec/history_summary.py
  check_item "Unidade Dropbear OnePlus" systemctl cat oneplus-dropbear.service
  check_item "Unidade WebSocket OnePlus" systemctl cat oneplus-websocket.service
  check_item "Unidade TLS OnePlus" systemctl cat oneplus-tls.service
  check_item "Unidade OpenVPN OnePlus" systemctl cat oneplus-openvpn.service
  check_item "Timer PKI OpenVPN" systemctl is-enabled oneplus-openvpn-pki-maintenance.timer
  check_item "Modo de autenticação OpenVPN válido" bash -c 'm=$(awk -F= '"'"'$1=="OPENVPN_AUTH_MODE"{print $2;exit}'"'"' /etc/oneplus/openvpn.env 2>/dev/null); [[ -z "$m" || "$m" == password || "$m" == hybrid ]]'
  check_item "Modo tls-crypt OpenVPN válido" bash -c 'm=$(awk -F= '"'"'$1=="OPENVPN_TLS_CRYPT_MODE"{print $2;exit}'"'"' /etc/oneplus/openvpn.env 2>/dev/null); [[ -z "$m" || "$m" == legacy || "$m" == dual || "$m" == v2 ]]'
  if [[ -s /etc/oneplus/openvpn/pki/server.crt ]]; then
    check_item "Saúde PKI OpenVPN" /opt/oneplus/modules/openvpn.sh health
  fi
  if [[ -r /etc/oneplus/openvpn/rotation/state.conf ]]; then
    check_item "Rotação PKI OpenVPN preparada" bash -c "grep -Fqx 'STATE=prepared' /etc/oneplus/openvpn/rotation/state.conf && test -s /etc/oneplus/openvpn/rotation/ca-bundle.crt && test -s /etc/oneplus/openvpn/rotation/crl-bundle.pem"
  fi
  check_item "Unidade Multiplexador OnePlus" systemctl cat oneplus-mux.service
  check_item "Unidade BadVPN instalada" systemctl cat oneplus-badvpn.service
  check_item "Unidade SlowDNS instalada" systemctl cat oneplus-slowdns.service
  check_item "Grupo de usuários OnePlus" getent group oneplus-users
  check_item "Diretório de metadados de usuários" test -d /var/lib/oneplus/users
  check_item "Arquivo de limites OnePlus" test -f /etc/security/limits.d/90-oneplus.conf
  check_item "Unidade de manutenção de usuários" systemctl cat oneplus-user-maintenance.service
  check_item "Timer de manutenção de usuários" systemctl is-enabled oneplus-user-maintenance.timer
  check_item "nftables instalado" bash -c 'command -v nft >/dev/null 2>&1'
  check_item "age instalado" bash -c 'command -v age >/dev/null 2>&1'
  check_item "minisign instalado" bash -c 'command -v minisign >/dev/null 2>&1'
  check_item "Configuração firewall OnePlus" test -r /etc/oneplus/firewall.env
  check_item "Unidade firewall OnePlus" systemctl cat oneplus-firewall.service
  check_item "Configuração do histórico leve" test -r /etc/oneplus/history.env
  check_item "Unidade de histórico leve" systemctl cat oneplus-history.service
  check_item "Timer de histórico leve" systemctl cat oneplus-history.timer

  printf "\nOpenSSH:   %b\n" "$(service_state ssh.service)"
  printf "Dropbear:  %b\n" "$(service_state oneplus-dropbear.service)"
  printf "WebSocket: %b\n" "$(service_state oneplus-websocket.service)"
  printf "TLS:       %b\n" "$(service_state oneplus-tls.service)"
  printf "OpenVPN:   %b\n" "$(service_state oneplus-openvpn.service)"
  printf "Multiplex: %b\n" "$(service_state oneplus-mux.service)"
  printf "BadVPN:    %b\n" "$(service_state oneplus-badvpn.service)"
  printf "SlowDNS:   %b\n" "$(service_state oneplus-slowdns.service)"
  printf "Usuários:  %b\n" "$(service_state oneplus-user-maintenance.timer)"
  printf "Firewall:  %b\n" "$(service_state oneplus-firewall.service)"
  printf "PKI timer: %b\n" "$(service_state oneplus-openvpn-pki-maintenance.timer)"
  printf "Histórico:  %b\n" "$(service_state oneplus-history.timer)"

  if (( failed )); then
    printf "\n%bVerificação concluída com falhas.%b\n" "$C_RED" "$C_RESET"
    return 1
  fi
  printf "\n%bVerificação concluída: OK.%b\n" "$C_GREEN" "$C_RESET"
}

show_help() {
  cat <<EOF2
OnePlus ${VERSION}
Uso:
  oneplus             Abre o menu interativo
  oneplus --check     Verifica a instalação
  oneplus --version   Mostra a versão
  oneplus users       Abre a gestão de usuários SSH
  oneplus dropbear    Abre a gestão do Dropbear
  oneplus websocket   Abre a gestão do WebSocket
  oneplus tls         Abre a gestão TLS/Stunnel
  oneplus openvpn     Abre a gestão OpenVPN
  oneplus mux         Abre o multiplexador sslh
  oneplus firewall    Auditoria de portas, nftables e NAT OpenVPN
  oneplus backup      Backup/restauração criptografado
  oneplus reports     Relatórios de usuários, sessões e tráfego
  oneplus diagnostics Diagnóstico e reparo seguro
  oneplus update      Menu de atualização assinada
  oneplus update --check        Verifica a release estável mais recente
  oneplus update --latest       Atualiza para a release estável mais recente
  oneplus update --tag vX.Y.Z   Atualiza para uma tag assinada específica
  oneplus history     Histórico leve de tráfego/sessões sem banco
  oneplus hardening   Auditoria de hardening (audit-only)
  oneplus --help      Mostra esta ajuda
EOF2
}

main_menu() {
  while true; do
    clear
    local ipaddr users_online
    ipaddr=$(primary_ipv4)
    users_online=$(who 2>/dev/null | wc -l | tr -d ' ')
    printf "%b╔════════════════════════════════════════════════════╗%b\n" "$C_CYAN" "$C_RESET"
    printf "%b║%b  %bONEPLUS%b  • SSH System Manager • v%-12s %b║%b\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$VERSION" "$C_CYAN" "$C_RESET"
    printf "%b╚════════════════════════════════════════════════════╝%b\n\n" "$C_CYAN" "$C_RESET"
    printf "Servidor: %s  |  Sessões: %s\n" "${ipaddr:-N/D}" "$users_online"
    printf "OpenSSH: %-16b Dropbear: %-16b WebSocket: %b\n" \
      "$(service_state ssh.service)" "$(service_state oneplus-dropbear.service)" "$(service_state oneplus-websocket.service)"
    printf "TLS:     %-16b OpenVPN:  %-16b Multiplex: %b\n" \
      "$(service_state oneplus-tls.service)" "$(service_state oneplus-openvpn.service)" "$(service_state oneplus-mux.service)"
    printf "BadVPN:  %-16b SlowDNS:   %-16b Firewall: %b\n\n" \
      "$(service_state oneplus-badvpn.service)" "$(service_state oneplus-slowdns.service)" "$(service_state oneplus-firewall.service)"
    printf "1) Usuários SSH\n"
    printf "2) Sistema e diagnóstico\n"
    printf "3) OpenSSH\n"
    printf "4) Dropbear SSH\n"
    printf "5) WebSocket\n"
    printf "6) TLS / Stunnel\n"
    printf "7) OpenVPN\n"
    printf "8) Multiplexador de portas / sslh\n"
    printf "9) BadVPN UDPGW\n"
    printf "10) SlowDNS / DNSTT\n"
    printf "11) Portas / Firewall / NAT\n"
    printf "12) Backup e restauração\n"
    printf "13) Relatórios\n"
    printf "14) Diagnóstico e reparo\n"
    printf "15) Atualização assinada\n"
    printf "16) Histórico leve\n"
    printf "17) Hardening audit-only\n"
    printf "18) Sobre esta versão\n"
    printf "0) Sair\n\nEscolha: "
    read -r opt
    case "$opt" in
      1) module_users ;;
      2) module_system ;;
      3) module_ssh ;;
      4) module_dropbear ;;
      5) module_websocket ;;
      6) module_tls ;;
      7) module_openvpn ;;
      8) module_mux ;;
      9) module_badvpn ;;
      10) module_slowdns ;;
      11) module_firewall ;;
      12) module_backup ;;
      13) module_reports ;;
      14) module_diagnostics ;;
      15) module_update ;;
      16) module_history ;;
      17) module_hardening ;;
      18)
        clear
        cat <<EOF2
OnePlus ${VERSION}
Base nova para gerenciamento de servidores via SSH.
Compatibilidade inicial: Ubuntu 24.04+.

Princípios:
- não substituir sshd_config integralmente;
- validar OpenSSH antes de reiniciar;
- serviços persistentes gerenciados por systemd;
- sem armazenamento de senhas em texto puro;
- sem limpeza de crontab, /bin, firewall ou configurações externas;
- módulos de rede explicitamente habilitados pelo administrador;
- Dropbear com root sempre bloqueado pelo OnePlus;
- WebSocket com destino fixo, sem open proxy/X-Real-Host dinâmico;
- TLS via stunnel com TLS 1.2+ e chave privada protegida;
- OpenVPN com PAM restrito às contas oneplus-users e mTLS opcional por dispositivo;
- revogação por CRL e rotação de certificado de dispositivo com janela de migração;
- rotação manual da infraestrutura OpenVPN com fase dual, tls-crypt-v2 e rollback;
- multiplexação TCP via sslh sem modo transparente;
- firewall/NAT opcional em tabelas nftables próprias, sem limpar regras existentes;
- backup criptografado com age, sem exportar /etc/shadow inteiro;
- atualizador estável fail-closed com minisign;
- contas SSH gerenciadas sem armazenar senhas;
- expiração e limites aplicados apenas a contas criadas pelo OnePlus;
- histórico leve opt-in, sem usernames/IPs remotos/payloads;
- hardening do host em modo audit-only: nenhuma mudança automática.
EOF2
        pause
        ;;
      0) clear; exit 0 ;;
      *) warn "Opção inválida"; sleep 1 ;;
    esac
  done
}

case "${1:-}" in
  "") main_menu ;;
  --check) health_check ;;
  --version|-V) printf 'OnePlus %s\n' "$VERSION" ;;
  users) module_users ;;
  dropbear) module_dropbear ;;
  websocket|ws) module_websocket ;;
  tls) module_tls ;;
  openvpn|vpn) module_openvpn ;;
  mux|sslh) module_mux ;;
  firewall|fw) module_firewall ;;
  backup|restore) module_backup ;;
  reports|report) module_reports ;;
  diagnostics|diag) module_diagnostics ;;
  update|upgrade) shift; update_cli "$@" ;;
  history) module_history ;;
  hardening|audit) module_hardening ;;
  --help|-h) show_help ;;
  *) error "Argumento desconhecido: $1"; show_help; exit 2 ;;
esac
